# Copy this file to /srv/sub2api/config/prod.env on the server.
# Never commit the real file. Generate independent random values for every secret.

SUB2API_DATA_ROOT=/srv/sub2api
SUB2API_IMAGE=ghcr.io/alphacall-ai/sub2api:prod
SUB2API_PORT=8080
TZ=Asia/Shanghai
RUN_MODE=standard

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=replace_with_a_different_long_random_password
REDIS_DB=0
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_random_admin_password
JWT_SECRET=replace_with_64_hex_characters
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=replace_with_another_64_hex_characters
SETUP_MIGRATION_TIMEOUT_SECONDS=120

LOG_LEVEL=info
LOG_FORMAT=json
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_MAX_BACKUPS=10
LOG_ROTATION_MAX_AGE_DAYS=7

